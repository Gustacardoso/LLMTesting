# Copy to .env — never commit real keys.
# Without any key the platform runs on a deterministic offline mock LLM + heuristic judge (demo mode).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
JUDGE_MODEL=gpt-4o-mini
POSTGRES_PASSWORD=postgres
# Set to http://evaluator:8000 and run `docker compose --profile full up` to use DeepEval + RAGAS
EVALUATOR_URL=
PUBLIC_API_URL=http://localhost:8080
